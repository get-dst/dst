# deploy/demo — copy to .env, fill in, never commit.
DST_IMAGE=ghcr.io/get-dst/dst:0.4.0
DEMO_DOMAIN=demo.example.com

POSTGRES_PASSWORD=
DST_APP_DB_PASSWORD=
DST_SECRET_KEY=            # dst secret

# DeepSeek for generation/composition, Jev (typesafe) for typed decisions.
DST_PROVIDERS={"deepseek": {"type": "openai-compatible", "base_url": "https://api.deepseek.com", "api_key": "sk-...", "fast_model": "deepseek-v4-flash"}, "jev": {"type": "typesafe", "api_key": "..."}}

DST_CLERK_PUBLISHABLE_KEY=pk_live_...
DST_CLERK_SECRET_KEY=sk_live_...

# Printed by `dst bootstrap --org demo` on the first boot; fill in, then restart app.
DST_DEMO_ORG_ID=
DST_DEMO_KEY_DAYS=7
DST_DAILY_REQUEST_CAP=2000

# A MotherDuck read-scaling token (read-only). The database must exist first.
MOTHERDUCK_TOKEN=
