{
 "compiled": {
  "{\"dimensions\": [\"contract_renewals_monthly.month\"], \"limit\": 1, \"order\": [[\"contract_renewals_monthly.month\", \"desc\"]]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "contract_renewals_monthly__month": "contract_renewals_monthly.month"
     },
     "sql": [
      "SELECT\n      timezone('UTC', CAST(\"contract_renewals_monthly\".month || '-01' AS DATE)::timestamptz) \"contract_renewals_monthly__month\"\n    FROM\n      marts_service.mart_contract_renewals_monthly AS \"contract_renewals_monthly\"  GROUP BY 1 ORDER BY 1 DESC LIMIT 1",
      []
     ]
    }
   },
   "status": 200
  },
  "{\"measures\": [\"contract_renewals_monthly.contract_renewal_rate\"], \"timeDimensions\": [{\"dateRange\": [\"2026-04-01\", \"2026-06-30\"], \"dimension\": \"contract_renewals_monthly.month\"}]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "contract_renewals_monthly__contract_renewal_rate": "contract_renewals_monthly.contract_renewal_rate"
     },
     "sql": [
      "SELECT\n      sum(\"contract_renewals_monthly\".renewed) / NULLIF(sum(\"contract_renewals_monthly\".renewed + \"contract_renewals_monthly\".churned), 0) \"contract_renewals_monthly__contract_renewal_rate\"\n    FROM\n      marts_service.mart_contract_renewals_monthly AS \"contract_renewals_monthly\"  WHERE (CAST(\"contract_renewals_monthly\".month || '-01' AS DATE) >= ?::timestamptz AND CAST(\"contract_renewals_monthly\".month || '-01' AS DATE) <= ?::timestamptz) LIMIT 10000",
      [
       "2026-04-01T00:00:00.000Z",
       "2026-06-30T23:59:59.999Z"
      ]
     ]
    }
   },
   "status": 200
  }
 },
