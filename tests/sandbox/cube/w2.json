  "{\"dimensions\": [\"work_orders.wo_type\"], \"measures\": [\"work_orders.job_margin_pct\"], \"timeDimensions\": [{\"dateRange\": [\"2026-04-01\", \"2026-06-30\"], \"dimension\": \"work_orders.completed_date\"}]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "work_orders__job_margin_pct": "work_orders.job_margin_pct",
      "work_orders__wo_type": "work_orders.wo_type"
     },
     "sql": [
      "SELECT\n      \"work_orders\".wo_type \"work_orders__wo_type\", sum(\"work_orders\".margin_eur) / NULLIF(sum(\"work_orders\".billed_amount_eur), 0) \"work_orders__job_margin_pct\"\n    FROM\n      intermediate.int_work_order_costs AS \"work_orders\"  WHERE (\"work_orders\".completed_date >= ?::timestamptz AND \"work_orders\".completed_date <= ?::timestamptz) GROUP BY 1 ORDER BY 2 DESC LIMIT 10000",
