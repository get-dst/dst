    "sql": {
     "aliasNameToMember": {
      "maintenance_contracts__end_date": "maintenance_contracts.end_date"
     },
     "sql": [
      "SELECT\n      timezone('UTC', \"maintenance_contracts\".end_date::timestamptz) \"maintenance_contracts__end_date\"\n    FROM\n      (SELECT * FROM raw_fieldflow.maintenance_contracts\nWHERE _synced_batch = 'B2026-08-31') AS \"maintenance_contracts\"  GROUP BY 1 ORDER BY 1 DESC LIMIT 1",
