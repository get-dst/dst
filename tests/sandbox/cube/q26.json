     },
     "sql": [
      "SELECT\n      timezone('UTC', \"maintenance_contracts\".start_date::timestamptz) \"maintenance_contracts__start_date\"\n    FROM\n      (SELECT * FROM raw_fieldflow.maintenance_contracts\nWHERE _synced_batch = 'B2026-08-31') AS \"maintenance_contracts\"  GROUP BY 1 ORDER BY 1 DESC LIMIT 1",
      []
     ]
    }
   },
   "status": 200
  },
  "{\"filters\": [{\"member\": \"customers.customer_type\", \"operator\": \"equals\", \"values\": [\"Housing company\"]}], \"measures\": [\"maintenance_contracts.active_contracts\"], \"timeDimensions\": [{\"dateRange\": [\"2026-09-01\", \"2026-10-30\"], \"dimension\": \"maintenance_contracts.end_date\"}]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "maintenance_contracts__active_contracts": "maintenance_contracts.active_contracts"
     },
     "sql": [
      "SELECT\n      count(CASE WHEN (\"maintenance_contracts\".status = 'Active') THEN \"maintenance_contracts\".contract_id END) \"maintenance_contracts__active_contracts\"\n    FROM\n      (SELECT * FROM raw_fieldflow.maintenance_contracts\nWHERE _synced_batch = 'B2026-08-31') AS \"maintenance_contracts\"\nLEFT JOIN marts_customer.dim_customer_360 AS \"customers\" ON \"maintenance_contracts\".customer_id = \"customers\".customer_id  WHERE (\"maintenance_contracts\".end_date >= ?::timestamptz AND \"maintenance_contracts\".end_date <= ?::timestamptz) AND (\"customers\".customer_type = ?) LIMIT 10000",
      [
       "2026-09-01T00:00:00.000Z",
       "2026-10-30T23:59:59.999Z",
       "Housing company"
      ]
     ]
    }
   },
   "status": 200
  }
