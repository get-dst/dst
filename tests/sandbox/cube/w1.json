  "{\"measures\": [\"quotes.quote_win_rate\"], \"timeDimensions\": [{\"dateRange\": [\"2026-04-01\", \"2026-06-30\"], \"dimension\": \"quotes.decided_date\"}]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "quotes__quote_win_rate": "quotes.quote_win_rate"
     },
     "sql": [
      "SELECT\n      count(CASE WHEN (\"quotes\".status = 'Won') THEN \"quotes\".quote_id END) / NULLIF(count(CASE WHEN (\"quotes\".status IN ('Won', 'Lost', 'Expired')) THEN \"quotes\".quote_id END), 0) \"quotes__quote_win_rate\"\n    FROM\n      staging.stg_pipedrive__quotes AS \"quotes\"  WHERE (\"quotes\".decided_date >= ?::timestamptz AND \"quotes\".decided_date <= ?::timestamptz) LIMIT 10000",
      [
       "2026-04-01T00:00:00.000Z",
       "2026-06-30T23:59:59.999Z"
      ]
     ]
    }
   },
   "status": 200
  },
  "{\"measures\": [\"quotes.quote_win_rate\"], \"timeDimensions\": [{\"dateRange\": [\"2026-07-01\", \"2026-08-31\"], \"dimension\": \"quotes.decided_date\"}]}": {
   "body": {
