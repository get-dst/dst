      "SELECT\n      timezone('UTC', \"quotes\".decided_date::timestamptz) \"quotes__decided_date\"\n    FROM\n      staging.stg_pipedrive__quotes AS \"quotes\"  GROUP BY 1 ORDER BY 1 DESC LIMIT 1",
