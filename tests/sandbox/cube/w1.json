     },
     "sql": [
      "SELECT\n      count(CASE WHEN (\"quotes\".status = 'Won') THEN \"quotes\".quote_id END) / NULLIF(count(CASE WHEN (\"quotes\".status IN ('Won', 'Lost', 'Expired')) THEN \"quotes\".quote_id END), 0) \"quotes__quote_win_rate\"\n    FROM\n      staging.stg_pipedrive__quotes AS \"quotes\"  WHERE (\"quotes\".decided_date >= ?::timestamptz AND \"quotes\".decided_date <= ?::timestamptz) LIMIT 10000",
      [
       "2026-07-01T00:00:00.000Z",
       "2026-08-31T23:59:59.999Z"
      ]
     ]
