{
 "compiled": {
  "{\"dimensions\": [\"crm_leads.created_date\"], \"limit\": 1, \"order\": [[\"crm_leads.created_date\", \"desc\"]]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "crm_leads__created_date": "crm_leads.created_date"
     },
     "sql": [
      "SELECT\n      timezone('UTC', \"crm_leads\".created_date::timestamptz) \"crm_leads__created_date\"\n    FROM\n      staging.stg_pipedrive__leads AS \"crm_leads\"  GROUP BY 1 ORDER BY 1 DESC LIMIT 1",
      []
     ]
    }
   },
   "status": 200
  },
  "{\"filters\": [{\"member\": \"crm_leads.segment\", \"operator\": \"equals\", \"values\": [\"Housing companies\"]}], \"measures\": [\"crm_leads.crm_lead_count\"], \"timeDimensions\": [{\"dateRange\": [\"2026-01-01\", \"2026-08-31\"], \"dimension\": \"crm_leads.created_date\"}]}": {
   "body": {
    "sql": {
     "aliasNameToMember": {
      "crm_leads__crm_lead_count": "crm_leads.crm_lead_count"
     },
     "sql": [
      "SELECT\n      count(\"crm_leads\".lead_id) \"crm_leads__crm_lead_count\"\n    FROM\n      staging.stg_pipedrive__leads AS \"crm_leads\"  WHERE (\"crm_leads\".created_date >= ?::timestamptz AND \"crm_leads\".created_date <= ?::timestamptz) AND (\"crm_leads\".segment = ?) LIMIT 10000",
      [
       "2026-01-01T00:00:00.000Z",
       "2026-08-31T23:59:59.999Z",
       "Housing companies"
      ]
     ]
    }
   },
   "status": 200
  }
 },
